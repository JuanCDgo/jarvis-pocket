# Configuración del Windows Agent de Jarvis Pocket
# Si no existe .env, agent/server.mjs genera automáticamente un JARVIS_TOKEN seguro al arrancar.
JARVIS_PORT=8787
JARVIS_TOKEN=
# Carpetas opcionales (por defecto: %USERPROFILE%\JarvisDrop y %USERPROFILE%\JarvisDownloads)
JARVIS_DROP_DIR=
JARVIS_DOWNLOADS_DIR=
# Instancia opcional de Cobalt self-hosted (ej. http://localhost:9000)
COBALT_API_URL=
